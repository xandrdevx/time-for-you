---
// Site header: logo + primary navigation.
// Structure mirrors the approved Header.dc.html wireframe (nav on the
// right) with the new logo-derived color tokens. No wordmark text and no
// booking CTA — appointments are made by phone, not through the site.
import { BUSINESS_NAME, NAV_ITEMS } from '@config/site';
import logo from '../assets/logo.png';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${BUSINESS_NAME} — home`}>
      <img src={logo.src} alt={`${BUSINESS_NAME} logo`} width="48" height="48" />
    </a>

    <button
      type="button"
      class="site-header__menu-toggle"
      aria-expanded="false"
      aria-controls="primary-navigation"
      id="menu-toggle"
    >
      <span class="visually-hidden">Menu</span>
      <span class="site-header__menu-icon" aria-hidden="true"></span>
    </button>

    <nav
      id="primary-navigation"
      class="site-header__nav"
      aria-label="Hoofdnavigatie"
    >
      <ul>
        {NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-ambient);
  }

  .site-header__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-sm) var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-ink);
    flex-shrink: 0;
  }

  .site-header__brand img {
    height: 48px;
    width: 48px;
    object-fit: contain;
  }

  .site-header__menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: var(--space-xs);
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
  }

  .site-header__menu-icon,
  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-ink);
    position: relative;
    transition: transform 0.2s ease;
  }

  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    content: '';
    position: absolute;
  }

  .site-header__menu-icon::before {
    top: -7px;
  }

  .site-header__menu-icon::after {
    top: 7px;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
  }

  .site-header__nav a {
    display: inline-block;
    white-space: nowrap;
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 500;
    font-size: 0.9rem;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-control);
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    background: var(--color-bg);
    color: var(--color-ink-2);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--color-primary);
    font-weight: 700;
  }

  /* Below this width, 9 nav items no longer comfortably fit on one line —
     fold them into the mobile menu instead of letting them wrap. */
  @media (max-width: 1100px) {
    .site-header__menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .site-header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-surface);
      align-items: stretch;
      padding: var(--space-md) var(--space-lg) var(--space-lg);
      box-shadow: var(--shadow-ambient);
      display: none;
    }

    .site-header__nav.is-open {
      display: flex;
    }

    .site-header__nav ul {
      flex-direction: column;
      align-items: stretch;
      flex-wrap: wrap;
      gap: var(--space-2xs);
    }

    .site-header__nav a {
      white-space: normal;
    }
  }
</style>

<script>
  // Small progressive-enhancement toggle for the mobile nav — no framework
  // needed for something this simple.
  const menuToggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('primary-navigation');

  menuToggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    menuToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
