---
// Gift-voucher amount picker + sender/receiver form. Visual-only stub for
// now — see brief "Out of scope for this prototype".
export const prerender = true;

import Layout from '@layouts/Layout.astro';
import { GIFT_VOUCHER_TIERS } from '@config/gift-vouchers';
import '@styles/pages/cadeaubon.css';
---

<Layout title="CadeauBon" description="Geef een Time For You cadeaubon cadeau.">
  <div class="page-container">
    <h1 class="section-heading">CadeauBon</h1>
    <p style="text-align:center">Kies het bedrag ofwel een sessie</p>

    <fieldset class="voucher-tiers" style="border:none;padding:0;margin:0 0 2.5rem">
      <legend class="visually-hidden">Kies een bedrag</legend>
      {GIFT_VOUCHER_TIERS.map((tier, index) => (
        <label class="voucher-tier">
          <input
            type="radio"
            name="voucher-amount"
            value={tier.amount}
            required
            checked={index === 0}
          />
          <span class="voucher-tier__card">
            <span class="voucher-tier__amount">€{tier.amount}</span>
            {tier.linkedSessions && (
              <span class="voucher-tier__sessions">of {tier.linkedSessions.join(', ')}</span>
            )}
          </span>
        </label>
      ))}
    </fieldset>

    <form class="voucher-form card" novalidate>
      <p>
        Bevestig je bedrag of sessie. Staat uw gewenste bedrag er niet bij? Contacteer mij dan.
      </p>

      <div class="field">
        <label for="voucher-message">Bericht aan ontvanger</label>
        <textarea id="voucher-message" name="message"></textarea>
      </div>

      <div class="field">
        <label for="voucher-sender-name">Uw naam</label>
        <input id="voucher-sender-name" name="senderName" type="text" required />
      </div>

      <div class="field">
        <label for="voucher-recipient-name">Naam van de ontvanger</label>
        <input id="voucher-recipient-name" name="recipientName" type="text" required />
      </div>

      <div class="field">
        <label for="voucher-recipient-email">Email van ontvanger</label>
        <input id="voucher-recipient-email" name="recipientEmail" type="email" required />
      </div>

      <button type="submit" class="button">Voeg toe aan winkelwagen</button>
      <!-- TODO: wire to Cloudflare Worker POST /api/cart/add -->
    </form>
  </div>
</Layout>

<script>
  const voucherForm = document.querySelector<HTMLFormElement>('.voucher-form');
  voucherForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (voucherForm.checkValidity()) {
      // TODO: wire to Cloudflare Worker POST /api/cart/add
      voucherForm.reset();
    } else {
      voucherForm.reportValidity();
    }
  });
</script>
