---
// Home page: hero, intro, treatment teaser, review teaser.
export const prerender = true;

import Layout from '@layouts/Layout.astro';
import StarRating from '@components/StarRating.astro';
import { getCollection } from 'astro:content';
import '@styles/pages/home.css';

const allTreatments = await getCollection('treatments');
const teaserTreatments = allTreatments.slice(0, 4);

const allReviews = await getCollection('reviews');
const teaserReviews = allReviews.slice(0, 3);
---

<Layout title="Home">
  <div class="page-container">
    <section class="hero">
      <h1 class="hero__title">TIME FOR YOU</h1>
      <p class="hero__subtitle">Voor een ontspannende of energetische massage.</p>
    </section>

    <section class="intro">
      <h2>Beste bezoeker</h2>
      <p>
        Dankjewel voor je bezoek aan deze site. Je bent hier niet toevallig terechtgekomen.
      </p>
      <p>
        Je hebt nood aan ontspanning? Of je zit met een emotionele blokkade? Zit je in de knoop
        met jezelf of heb je nood om terug te keren naar jezelf, naar je innerlijke? Dan is Time
        For You the place to be.
      </p>
      <p>
        Bij mij kan je terecht voor meerdere vormen van massage zoals ontspanningsmassage, Lomi
        Lomi ...... voor elk wat wils. Verken gerust de mogelijkheden en tot binnenkort.
      </p>
      <p class="intro__tagline">It's <em>Time For You</em> now!</p>
    </section>

    <section aria-labelledby="treatments-heading">
      <h2 id="treatments-heading" class="section-heading">Behandelingen</h2>
      <div class="teaser-grid">
        {teaserTreatments.map((treatment) => (
          <a class="teaser-card" href={`/behandelingen/${treatment.data.slug}`}>
            <img
              src={`/images/treatments/${treatment.data.slug}.jpg`}
              alt={treatment.data.name}
              width="320"
              height="240"
              loading="lazy"
            />
            <h3>{treatment.data.name}</h3>
            <p>{treatment.data.shortDescription}</p>
            <span class="price">€{treatment.data.price}</span>
          </a>
        ))}
      </div>
      <p class="section-cta"><a class="button" href="/behandelingen">Bekijk alle behandelingen</a></p>
    </section>

    <section aria-labelledby="reviews-heading">
      <h2 id="reviews-heading" class="section-heading">Recensies</h2>
      <div class="review-teaser-grid">
        {teaserReviews.map((review) => (
          <div class="card review-teaser-card">
            <StarRating rating={review.data.rating} />
            <p>&ldquo;{review.data.text.slice(0, 160)}{review.data.text.length > 160 ? '…' : ''}&rdquo;</p>
            <cite>{review.data.author} — {review.data.date}</cite>
          </div>
        ))}
      </div>
      <p class="section-cta"><a class="button button--secondary" href="/recensies">Lees alle recensies</a></p>
    </section>
  </div>
</Layout>
