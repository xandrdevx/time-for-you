---
import '../styles/home.css';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { SITE_NAME, SITE_TAGLINE } from '../config/siteConfig';
import {
  HOME_CAROUSEL,
  HOME_CLOSING_LINES,
  HOME_WELCOME,
  HOME_WELCOME_IMAGE,
} from '../config/homeContent';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import { HOME_CAROUSEL_SLIDES } from '../lib/homeCarouselSlides';
---

<BaseLayout>
  <PhotoCarousel
    slides={HOME_CAROUSEL_SLIDES}
    ariaLabel={HOME_CAROUSEL.ariaLabel}
    imageWidth={HOME_CAROUSEL.imageWidth}
    autoplayIntervalMilliseconds={HOME_CAROUSEL.autoplayIntervalMilliseconds}
  />

  <section class="home-hero page-section">
    <div class="page-section__inner block home-hero__block">
      <h1 class="home-hero__title">{SITE_NAME.toUpperCase()}</h1>
      <p class="home-hero__tagline">{SITE_TAGLINE}</p>
    </div>
  </section>

  <section class="home-welcome">
    <!-- Grid layout: the white panel, the photo and the text each have their own grid area. The photo
         overlaps the panel edge only; the text column starts after the photo, so nothing covers text. -->
    <div class="home-welcome__layout">
      <div class="home-welcome__panel" aria-hidden="true"></div>
      <figure class="home-welcome__photo">
        <Image
          class="home-welcome__image"
          src={HOME_WELCOME_IMAGE.image}
          alt={HOME_WELCOME_IMAGE.altText}
          width={HOME_WELCOME_IMAGE.width}
          height={HOME_WELCOME_IMAGE.height}
        />
      </figure>
      <div class="home-welcome__text">
        <h2 class="home-welcome__greeting">{HOME_WELCOME.greeting}</h2>
        {HOME_WELCOME.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="home-welcome__closing">
          <span class="home-welcome__closing-lead">{HOME_CLOSING_LINES.lead}</span>
          <span class="home-welcome__closing-highlight">{HOME_CLOSING_LINES.highlight}</span>
          <span class="home-welcome__closing-tail">{HOME_CLOSING_LINES.tail}</span>
        </p>
      </div>
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>
