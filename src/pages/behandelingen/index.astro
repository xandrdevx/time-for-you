---
// Grid of all 8 treatments, each card links to its detail page.
export const prerender = true;

import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import '@styles/pages/behandelingen.css';

const treatments = await getCollection('treatments');
---

<Layout title="Behandelingen" description="Ontdek alle massagebehandelingen bij Time For You.">
  <div class="page-container">
    <h1 class="section-heading">Ontdek onze behandelingen</h1>

    <div class="treatment-grid">
      {treatments.map((treatment) => (
        <article class="card treatment-card">
          <img
            src={`/images/treatments/${treatment.data.slug}.jpg`}
            alt={treatment.data.name}
            width="320"
            height="240"
            loading="lazy"
          />
          <h2>{treatment.data.name}</h2>
          <p>{treatment.data.shortDescription}</p>
          <span class="price">€{treatment.data.price}</span>
          <a class="button button--secondary read-more" href={`/behandelingen/${treatment.data.slug}`}>
            Lees meer
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>
