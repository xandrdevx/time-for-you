---
// Price table. Uses the canonical list from content-nl.md — see
// CONTENT_TODO.md for the Lomi Lomi price discrepancy still to confirm.
export const prerender = true;

import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import '@styles/pages/prijzen.css';

const treatments = await getCollection('treatments');
---

<Layout title="Prijzen" description="Prijslijst van alle behandelingen bij Time For You.">
  <div class="page-container price-table-wrapper">
    <h1 class="section-heading">Prijzen</h1>

    <table class="price-table">
      <thead>
        <tr>
          <th scope="col">Behandeling</th>
          <th scope="col">Prijs</th>
        </tr>
      </thead>
      <tbody>
        {treatments.map((treatment) => (
          <tr>
            <td>{treatment.data.name}</td>
            <td>€{treatment.data.price}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="price-note">
      Prijzen onder voorbehoud van bevestiging. Neem gerust <a href="/contacteer-mij">contact</a>
      op bij vragen.
    </p>
  </div>
</Layout>
